# Alamat backend. Dipakai saat VITE_USE_MOCK=false
VITE_API_URL=http://localhost:5000/api

# true  = pakai data tiruan di browser (backend belum siap)
# false = panggil backend asli di VITE_API_URL
VITE_USE_MOCK=true

# Midtrans Client Key Sandbox (opsional jika backend sudah menyediakannya di endpoint pembayaran)
VITE_MIDTRANS_CLIENT_KEY=
