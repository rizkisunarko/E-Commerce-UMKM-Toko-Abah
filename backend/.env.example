PORT=5000
FRONTEND_URL=http://localhost:5173
# MySQL harus aktif sebelum menjalankan `npm run db:setup`.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=budiono30
DB_NAME=toko_abah
# Ganti dengan nilai acak minimal 32 karakter sebelum menjalankan backend.
JWT_SECRET=ganti_dengan_string_acak
# Midtrans Snap Sandbox keys; Server Key hanya digunakan oleh backend.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Signature Secret Key dipakai backend untuk memverifikasi notifikasi Midtrans.
MIDTRANS_SIGNATURE_SECRET_KEY=
# API key Shipping Cost Sandbox; simpan key sebenarnya hanya di backend/.env.
RAJAONGKIR_API_KEY=
